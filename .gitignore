# Terraform state — never commit these
*.tfstate
*.tfstate.backup
*.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# OS files
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/

# SSH private keys - NEVER commit these
*.pem
bridgepoint-key
bridgepoint-key.pub
